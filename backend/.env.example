# TrustMesh Backend & Agent Environment Configuration

# Server Port
PORT=3001

# NEAR Protocol Configuration
NEAR_NETWORK_ID=testnet
NEAR_NODE_URL=https://rpc.testnet.near.org
NEAR_CONTRACT_ID=trustmesh.testnet
NEAR_OPERATOR_ACCOUNT_ID=relayer.trustmesh.testnet
NEAR_OPERATOR_PRIVATE_KEY=ed25519:3D2v...your_operator_private_key_here

# Mode: Set to "true" to use stateful in-memory contract simulation (instant local testing without network/faucet)
# Set to "false" to interact with live NEAR Testnet / Mainnet
MOCK_NEAR=true

# AI Policy Guard & Escrow Configuration
ESCROW_ACCOUNT_ID=escrow.trustmesh.testnet
SPEND_GUARD_THRESHOLD=65
ESCROW_WITHHOLDING_PERCENT=35

# Cross-Chain Intent API Webhook Secret (NEAR Intents / 1Click API)
WEBHOOK_SECRET=trustmesh_dev_secret_89f41b2

