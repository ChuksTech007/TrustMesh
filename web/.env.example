# Copy to web/.env.local. Never commit the copy. Keys are full-access
# except NEAR_POLICY_KEY, which must be the function-call key from
# `node scripts/add-policy-key.mjs`.

NEAR_NETWORK_ID=testnet
NEAR_NODE_URL=https://rpc.testnet.near.org
NEAR_CONTRACT_ID=trustmesh.testnet

# Client signs open_mandate, fund_mandate, accept_mandate, dispute_mandate.
NEAR_CLIENT_ID=client.trustmesh.testnet
NEAR_CLIENT_KEY=ed25519:...

# Maker signs deliver_mandate.
NEAR_MAKER_ID=maker.trustmesh.testnet
NEAR_MAKER_KEY=ed25519:...

# Full-access key used once by `npm run policy-key` to add the limited key.
# Do not put this key in NEAR_POLICY_KEY.
NEAR_POLICY_ID=policy.trustmesh.testnet
NEAR_POLICY_FULL_KEY=ed25519:...
NEAR_POLICY_KEY=ed25519:...

# Uncomment only when the contract account is not the client account.
# NEAR_CONTRACT_KEY=ed25519:...

# Addresses used only as the dry-quote recipient and refund target.
# They are the examples from the 1Click API docs. No funds are sent.
QUOTE_SOLANA_RECIPIENT=13QkxhNMrTPxoCkRdYdJ65tFuwXPhL5gLS2Z5Nr6gjRK
QUOTE_BASE_REFUND=0x2527D02599Ba641c19FEa793cD0F167589a0f10D
